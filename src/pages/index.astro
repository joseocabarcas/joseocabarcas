---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PlayerCardHero from '../components/PlayerCardHero.astro';
import CareerStats from '../components/CareerStats.astro';
import SeasonLog from '../components/SeasonLog.astro';
import Attributes from '../components/Attributes.astro';
import Highlights from '../components/Highlights.astro';
import GameLog from '../components/GameLog.astro';
import DraftMe from '../components/DraftMe.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

const title = 'José Cabarcas — Senior Software Engineer';
const description =
  'Senior Software Engineer with 11+ years shipping frontend and mobile products used by millions — leading teams and architecture, and deliberately crossing into backend when the problem demands it.';
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content" tabindex="-1">
    <PlayerCardHero identity={profile.hero} links={profile.links} />
    <CareerStats stats={profile.stats} />
    <SeasonLog entries={profile.seasonLog} />
    <Attributes groups={profile.attributes} />
    <Highlights highlights={profile.highlights} />
    <GameLog caseStudies={profile.gameLog} />
    <DraftMe identity={profile.hero} links={profile.links} />
  </main>
  <Footer links={profile.links} />
</Layout>
