---
const codeLines = [
  { type: 'tag', content: '<html>' },
  { type: 'tag', content: '  <head>', indent: 1 },
  { type: 'tag', content: '    <title>Portfolio</title>', indent: 2 },
  { type: 'tag', content: '  </head>', indent: 1 },
  { type: 'tag', content: '  <body>', indent: 1 },
  { type: 'tag', content: '    <h1>Hello World!</h1>', indent: 2 },
  { type: 'tag', content: '  </body>', indent: 1 },
  { type: 'tag', content: '</html>' }
];
---

<div class="code-window">
  <div class="code-header">
    <div class="code-dots">
      <div class="code-dot dot-red"></div>
      <div class="code-dot dot-yellow"></div>
      <div class="code-dot dot-green"></div>
    </div>
    <div class="window-title">index.html</div>
  </div>
  <div class="code-content">
    {codeLines.map(line => (
      <div class="code-line">
        <span class="line-number">{codeLines.indexOf(line) + 1}</span>
        <span class="code-text">{line.content}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .code-window {
    background: #2c3e50;
    border-radius: 12px;
    position: relative;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    max-width: 400px;
    width: 100%;
  }

  .code-header {
    display: flex;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
  }

  .code-dots {
    display: flex;
    gap: 8px;
  }

  .code-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red { background: #e74c3c; }
  .dot-yellow { background: #f39c12; }
  .dot-green { background: #2ecc71; }

  .window-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: #bdc3c7;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .code-content {
    padding: 1rem;
    font-family: 'Fira Code', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .code-line {
    display: flex;
    margin-bottom: 4px;
  }

  .line-number {
    color: rgba(255, 255, 255, 0.4);
    margin-right: 1rem;
    min-width: 20px;
    text-align: right;
    user-select: none;
  }

  .code-text {
    color: #ecf0f1;
  }

  @media (max-width: 768px) {
    .code-window {
      max-width: 300px;
    }
    
    .code-content {
      font-size: 0.75rem;
    }
  }
</style>