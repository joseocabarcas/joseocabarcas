---
import Section from './Section.astro';

interface Props {
  name: string;
  role: string;
  bio: string[];
  experience: string;
}

const { name, role, bio, experience } = Astro.props;
---

<Section id="about" title="About Me">
  <div class="about-content">
    <div class="profile-card">
      <div class="profile-image">
        {name.split(' ').map(n => n[0]).join('')}
      </div>
      <h3>{name}</h3>
      <p class="role">{role}</p>
      <div class="social-links">
        <a href="#" aria-label="GitHub">📱</a>
        <a href="#" aria-label="LinkedIn">💼</a>
        <a href="#" aria-label="Twitter">🐦</a>
      </div>
    </div>
    <div class="about-text">
      <h3>Hi, how's it going?</h3>
      {bio.map(paragraph => <p>{paragraph}</p>)}
      <p class="experience">{experience}</p>
    </div>
  </div>
</Section>

<style>
  .about-content {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 3rem;
    align-items: start;
    margin-top: 2rem;
  }

  .profile-card {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2rem;
    text-align: center;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(46, 204, 113, 0.2);
    position: sticky;
    top: 120px;
  }

  .profile-image {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    margin: 0 auto 1rem;
    background: linear-gradient(45deg, #2ecc71, #27ae60);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: white;
    font-weight: bold;
  }

  .role {
    color: #bdc3c7;
    margin-bottom: 1.5rem;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social-links a {
    text-decoration: none;
    font-size: 1.5rem;
    transition: transform 0.3s ease;
  }

  .social-links a:hover {
    transform: scale(1.2);
  }

  .about-text {
    line-height: 1.8;
    color: #bdc3c7;
  }

  .about-text h3 {
    color: #2ecc71;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .about-text p {
    margin-bottom: 1rem;
  }

  .experience {
    font-weight: 600;
    color: #2ecc71 !important;
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
      text-align: center;
    }
    
    .profile-card {
      position: static;
    }
  }
</style>