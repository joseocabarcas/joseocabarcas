---
const navItems = [
  { href: '#career-stats', label: 'Career Stats' },
  { href: '#season-log', label: 'Season Log' },
  { href: '#attributes', label: 'Attributes' },
  { href: '#highlights', label: 'Highlights' },
  { href: '#game-log', label: 'Game Log' },
  { href: '#draft-me', label: 'Draft Me' },
];
---

<header class="site-header">
  <div class="header-inner">
    <span class="wordmark">JC <em>/</em> PROFILE</span>
    <nav class="site-nav" aria-label="Primary">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav-list">
        <span class="menu-toggle-label">Menu</span>
      </button>
      <ul class="nav-list" id="site-nav-list">
        {
          navItems.map((item) => (
            <li>
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="header-cta" href="#draft-me">Draft Me</a>
    </nav>
  </div>
</header>
