---
import type { ProfileLink } from '../data/profile';

export interface Props {
  links: ReadonlyArray<ProfileLink>;
}

const { links } = Astro.props;

const sectionLinks = [
  { href: '#career-stats', label: 'Career Stats' },
  { href: '#season-log', label: 'Season Log' },
  { href: '#attributes', label: 'Attributes' },
  { href: '#highlights', label: 'Highlights' },
  { href: '#game-log', label: 'Game Log' },
  { href: '#draft-me', label: 'Draft Me' },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <p class="footer-mark">JC <em>/</em> PROFILE</p>
      <p class="footer-note">
        Frontend Staff Engineer · Barranquilla, Colombia
      </p>
    </div>

    <div>
      <p class="footer-heading">Sections</p>
      <ul class="footer-links">
        {
          sectionLinks.map((item) => (
            <li>
              <a class="footer-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="footer-heading">Contact</p>
      <ul class="footer-contact">
        {
          links.map((link) => (
            <li>
              <a
                class="footer-link"
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="footer-bottom-inner">
      © {currentYear} José Cabarcas — a player-profile portfolio concept.
    </p>
  </div>
</footer>
